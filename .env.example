# =====================================================================
# FitVise — environment configuration
# Copy to `.env` (`cp .env.example .env`) and adjust before first run.
# All variables are read by the backend (see packages/backend/app/config.py).
# =====================================================================

# ---- Core ----------------------------------------------------------
# Signing secret for JWT / web sessions. Generate: openssl rand -hex 32
FITVISE_SECRET_KEY=change-me-dev-secret-do-not-use-in-prod

# Deployment mode: single_user | multi_user | managed
FITVISE_AUTH_MODE=multi_user

# Public base URL of this instance. Used in MCP connection instructions
# and OAuth discovery metadata. No trailing slash.
FITVISE_BASE_URL=http://localhost:8000

# Port the backend API listens on (inside the container).
FITVISE_PORT=8000

# ---- Database ------------------------------------------------------
# sqlite | postgres
FITVISE_DB_TYPE=postgres

# Used when FITVISE_DB_TYPE=sqlite (path inside the backend container).
FITVISE_DB_PATH=/data/fitvise.sqlite3

# Used when FITVISE_DB_TYPE=postgres. The compose file wires this for you.
FITVISE_DB_URL=postgresql+psycopg://fitvise:fitvise@db:5432/fitvise

# Postgres container bootstrap (only used by the `db` service in compose).
POSTGRES_USER=fitvise
POSTGRES_PASSWORD=fitvise
POSTGRES_DB=fitvise

# ---- MCP -----------------------------------------------------------
# Static key for single-user stdio mode ONLY. Ignored in multi_user/managed.
# Generate: openssl rand -hex 24
FITVISE_MCP_API_KEY=

# ---- OAuth 2.1 (multi_user / managed only) -------------------------
# Issuer / authorization-server base URL. Usually equals FITVISE_BASE_URL.
FITVISE_OAUTH_ISSUER_URL=http://localhost:8000
# Token signing key for OAuth access/refresh tokens. Generate: openssl rand -hex 32
FITVISE_OAUTH_SIGNING_KEY=change-me-oauth-signing-key

# ---- Notifications (Web Push / VAPID) ------------------------------
# Generate a VAPID keypair once and paste here. See docs/self-hosting.md.
# (helper: `docker compose run --rm backend python -m app.notifications.vapid_gen`)
FITVISE_VAPID_PUBLIC_KEY=
FITVISE_VAPID_PRIVATE_KEY=
# Contact used in the Web Push `aud`/`sub` claim (mailto: or https URL).
FITVISE_VAPID_SUBJECT=mailto:admin@example.com

# Default IANA timezone used for scheduling daily reminders when a user
# has not set their own.
FITVISE_DEFAULT_TIMEZONE=UTC

# ---- Frontend ------------------------------------------------------
# Where the browser app should reach the backend API. Baked at build time.
# In production this MUST be the public https domain that CloudPanel maps to
# the backend (e.g. https://api.fitvise.example.com).
VITE_API_BASE_URL=http://localhost:8000

# =====================================================================
# PRODUCTION (docker-compose.prod.yml) — VPS behind CloudPanel proxy
# =====================================================================
# In prod, published ports are bound to 127.0.0.1 (loopback) so ONLY the
# host reverse proxy can reach them. Pick free ports on your VPS; CloudPanel
# reverse proxies your domains to these:
#
#   FITVISE_FRONTEND_HOST_PORT  ->  the PWA (nginx)     e.g. app.fitvise.example.com
#   FITVISE_BACKEND_HOST_PORT   ->  API + /mcp + OAuth  e.g. api.fitvise.example.com
#
# FITVISE_FRONTEND_HOST_PORT=8080
# FITVISE_BACKEND_HOST_PORT=8000
#
# Public URLs must all be the https domains served by CloudPanel:
#   FITVISE_BASE_URL=https://api.fitvise.example.com
#   FITVISE_OAUTH_ISSUER_URL=https://api.fitvise.example.com
#   VITE_API_BASE_URL=https://api.fitvise.example.com
#
# Generate real secrets (do NOT reuse the dev defaults above):
#   FITVISE_SECRET_KEY / FITVISE_OAUTH_SIGNING_KEY : openssl rand -hex 32
#   POSTGRES_PASSWORD                              : openssl rand -hex 24
